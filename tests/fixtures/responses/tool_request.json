{
  "model": "fixture-model",
  "instructions": "Inspect local files.",
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Inspect Cargo.toml."
        }
      ]
    },
    {
      "type": "message",
      "role": "assistant",
      "content": [
        {
          "type": "output_text",
          "text": "I will read it."
        }
      ]
    },
    {
      "type": "function_call",
      "call_id": "call-read",
      "name": "read_file",
      "arguments": "{\"path\":\"Cargo.toml\"}"
    },
    {
      "type": "function_call_output",
      "call_id": "call-read",
      "output": "{\"status\":\"succeeded\",\"output\":{\"content\":\"fixture\"}}"
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "read_file",
      "description": "Use when: one local file\nDo not use when: a batch or search is needed.\nPrefer: line ranges.\nProduces: content, bytes and truncation.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "execution": {
            "type": "object",
            "properties": {
              "rerun_reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "rerun_reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": false,
  "store": false,
  "stream": true
}
